# Copy this file to .env for LOCAL testing only. Never commit .env.
# On Render, set these in Dashboard -> your service -> Environment.

# From @BotFather. Paste it ONLY into Render's Environment tab or your local .env, never into code or chat.
BOT_TOKEN=

# Your Render URL, e.g. https://web3-job-finder.onrender.com (no trailing slash)
PUBLIC_BASE_URL=

# Long random string. Render's blueprint generates it automatically.
WEBHOOK_SECRET=

# webhook (Render) or polling (your own computer / Termux)
BOT_MODE=webhook

# Your numeric Telegram user ID (get it from @userinfobot, or send /myid to the bot). Several: 111,222
# ADMIN_IDS and ADMIN_TELEGRAM_IDS are merged (union): either works, both is fine.
ADMIN_IDS=
ADMIN_TELEGRAM_IDS=

# Bot @username without "@". Optional: read from Telegram (getMe) at startup when empty. Used for invite links.
BOT_USERNAME=
# Mini App short name from @BotFather (/newapp). Optional. Enables t.me/<bot>/<short>?startapp=ref_... links.
MINIAPP_SHORT_NAME=

# Per-user daily limits for paid calls (admins are unlimited). 0 = feature off for normal users.
USER_DAILY_SEARCHES=3
USER_DAILY_DRAFTS=20
# Max valid referrals one inviter can earn per hour (extra ones are recorded as invalid).
REFERRAL_HOURLY_CAP=20
# In-memory API rate limits (requests per minute)
RATE_LIMIT_USER_PER_MIN=120
RATE_LIMIT_IP_PER_MIN=300

# Channel for admin announcements, e.g. @my_web3_jobs. Add the bot as channel admin first.
CHANNEL_ID=

# Leave empty to use SQLite locally. Render's blueprint fills this with PostgreSQL.
DATABASE_URL=sqlite+aiosqlite:///./data/jobs.db

FETCH_INTERVAL_MINUTES=60
JOB_RETENTION_DAYS=45

# --- AI job agent (all optional) ---
# FREE DEFAULT: one Google Gemini key does AI scoring, message drafts AND Google search (Grounding with Google
# Search) AND X hiring-post search. Get it at https://aistudio.google.com/apikey and paste it into LLM_API_KEY.
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.5-flash
# Used once automatically if LLM_MODEL is not available for your key.
LLM_FALLBACK_MODEL=gemini-flash-latest
# Free-tier guards: AI scoring calls per search run, AI calls per UTC day, seconds between AI calls.
LLM_MAX_CALLS_PER_RUN=5
LLM_DAILY_CALL_CAP=200
LLM_MIN_INTERVAL_SEC=4
# Gemini grounding (Google search through Gemini). Uses LLM_API_KEY when it is a Gemini key; set GEMINI_API_KEY
# only if LLM_API_KEY points at another provider. Max grounded search prompts per UTC day:
GEMINI_API_KEY=
GEMINI_SEARCH_MODEL=
GEMINI_GROUNDING_DAILY_CAP=150
# Optional paid search APIs. Order used: Serper > Brave > Gemini grounding.
SERPER_API_KEY=
BRAVE_API_KEY=
# Optional X APIs. Order used: X API > TwitterAPI.io > Gemini grounding (site:x.com) > ChatGPT web search.
X_BEARER_TOKEN=
TWITTERAPI_IO_KEY=
# Optional ChatGPT (OpenAI): only used when LLM_API_KEY is empty, or as a fallback when Gemini fails.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
SESSION_ENC_KEY=
TG_API_ID=
TG_API_HASH=
